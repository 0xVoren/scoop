{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022"],
    "typeRoots": ["../keeper/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@solana/web3.js": ["../keeper/node_modules/@solana/web3.js"],
      "@solana/spl-token": ["../keeper/node_modules/@solana/spl-token"]
    }
  },
  "include": ["./**/*.ts", "../keeper/src/solana/**/*.ts"]
}
