# =============================================================================
# Scoop Web — env template (no secrets). Copy to `.env.local` and edit.
# Never put private keys / mnemonics / WalletConnect secrets that must stay private
# in this file. `.env.local` is gitignored.
# Full testnet runbook: docs/frontend-testnet.md
# =============================================================================

# --- Mode A: local Anvil + Solana localnet (default for fresh clone) ---
NEXT_PUBLIC_CHAIN=local
NEXT_PUBLIC_SCOOP_DIAMOND=0x0000000000000000000000000000000000000000
# Required on mainnet/testnet: diamond deploy block for SharesPurchased log scans.
# Local (NEXT_PUBLIC_CHAIN=local) may omit or use 0.
NEXT_PUBLIC_SCOOP_DEPLOY_BLOCK=0
NEXT_PUBLIC_KEEPER_URL=
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_BSC_RPC=
# GitHub Pages project site only, e.g. /scoop. Custom domain / root: leave empty.
NEXT_PUBLIC_BASE_PATH=

# Solana localnet
# Cluster: local | localnet | devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_CLUSTER=localnet
# Anchor program id (base58). Default = programs/ localnet keypair.
NEXT_PUBLIC_SOLANA_PROGRAM_ID=FC9im2jkXhYciLgvEMTgrmvmKMPFkehyM1g3EEnUrpHT
NEXT_PUBLIC_SOLANA_RPC=http://127.0.0.1:8899

# --- Mode B: BSC testnet + Solana devnet (copy into `.env.local` for UI QA) ---
# Addresses from docs/testnet-contracts-deploy.md — public on-chain; still no keys here.
# NEXT_PUBLIC_CHAIN=testnet
# NEXT_PUBLIC_SCOOP_DIAMOND=0xfB2678ff49967B073F6537781EC3d35DE731a5DF
# NEXT_PUBLIC_SCOOP_DEPLOY_BLOCK=143943857
# NEXT_PUBLIC_BSC_RPC=https://bsc-testnet-rpc.publicnode.com
# NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# NEXT_PUBLIC_SOLANA_PROGRAM_ID=FC9im2jkXhYciLgvEMTgrmvmKMPFkehyM1g3EEnUrpHT
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# NEXT_PUBLIC_KEEPER_URL=
# NEXT_PUBLIC_WC_PROJECT_ID=
